  {
    "id": "user-setrole",
    "section": "Users",
    "title": "Change role",
    "path": "/admin/user/action",
    "permission": "owner",
    "fields": [
      {
        "key": "u",
        "label": "Username",
        "kind": "text",
        "required": true
      },
      {
        "key": "reason",
        "label": "Reason",
        "kind": "text",
        "required": false
      },
      {
        "key": "role",
        "label": "Role",
        "kind": "text",
        "required": true,
        "choices": [
          "user",
          "moderator",
          "admin"
        ]
      }
    ],
    "fixed": {
      "action": "setrole"
    },
    "confirmation": "CONFIRM",
    "explanation": "Target account changes take effect on the next request. Release deletes registration only; delete removes account, memory, moderation, telemetry and assigned key. The owner account is protected."
  },
